// mp4-to-smk.rc: the program's version resource, what Windows' file Properties show for it, as any ordinary tool has (Bishop's order 11-19, the owner's antivirus
// question: a program that says what it is, who made it and under which licence). Written 2026-11-19 by Melanikus (Drake) for AVP_OpenInteng. AVP_OpenInteng's own
// code: see License.txt, "AVP_OpenInteng's own code". The version is the next release's, 1.0.0-alpha.3, until release.yml passes its own.
// The build with the encoder compiled in (EncoderBuiltIn=true in mp4-to-smk.vcxproj, SMK_ENCODER_BUILT_IN) holds libsmackerenc (LGPL 2.1), so that program as a whole
// is under the LGPL 2.1, and its LegalCopyright says so; the build that loads libsmackerenc.dll beside it is AVP_OpenInteng's own code, MIT.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,3
 PRODUCTVERSION 1,0,0,3
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "the AVP_OpenInteng contributors"
			VALUE "FileDescription", "Converts a video to an AvP message video (.smk)"
			VALUE "FileVersion", "1.0.0-alpha.3"
			VALUE "InternalName", "mp4-to-smk"
#if defined(SMK_ENCODER_BUILT_IN)
			VALUE "LegalCopyright", "Copyright (c) 2026 the AVP_OpenInteng contributors (MIT License, License.txt); libsmackerenc Copyright (C) 2011 Barry Duncan. This program holds libsmackerenc and as a whole is under the GNU Lesser General Public License 2.1."
#else
			VALUE "LegalCopyright", "Copyright (c) 2026 the AVP_OpenInteng contributors. MIT License (License.txt)."
#endif
			VALUE "OriginalFilename", "mp4-to-smk.exe"
			VALUE "ProductName", "AVP_OpenInteng"
			VALUE "ProductVersion", "1.0.0-alpha.3"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
