      <OmitFramePointers>true</OmitFramePointers>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <AdditionalIncludeDirectories>..\..\avpx\3dc;..\..\avpx\3dc\video;..\..\avpx\3dc\avp;..\..\avpx\3dc\avp\support;..\..\avpx\3dc\avp\win95;..\..\avpx\3dc\avp\win95\frontend;..\..\avpx\3dc\avp\win95\gadgets;..\..\avpx\3dc\include;..\..\avpx\3dc\win95;..\..\avpx\win32;..\..\avpx\dependencies\libbinkdec\include;..\..\avpx\dependencies\libsmackerdec\include;$(VcpkgInstalledDir)$(VcpkgTriplet)\include\dxsdk-d3dx;$(VcpkgInstalledDir)$(VcpkgTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
