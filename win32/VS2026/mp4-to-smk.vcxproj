<?xml version="1.0" encoding="utf-8"?>
<!-- mp4-to-smk's project: the command-line tool that makes a user's own video (Media Foundation's common containers: video_import.h's one list) into an AvP message
     video (.smk, 128 x 96, 15 fps, 22050 Hz 8-bit mono). Written 2026-11-18 by Melanikus (Vasquez) for AVP_OpenInteng; its source is AVP_OpenInteng's own code (MIT,
     License.txt). Its work is THE ONE LIBRARY the editor's Video mode links too (videomake_static.vcxproj, Dietrich 11-22: video_import, video_make, smk_encoder),
     which this project links rather than compiling those sources itself, so the two never make a film differently.
     It reads the video through Windows' own Media Foundation (src\host\video_import) and encodes it with libsmackerenc (LGPL 2.1,
     AvPx's dependencies\libsmackerenc), LINKED IN from a static library of its own (libsmackerenc_static.vcxproj, built from the library's own sources with
     its own settings; the owner's order 11-21 through Bishop, "STATIC LINK, SEPARATE BARRY'S LIBS"), so it loads no DLL, has no pin and needs no BCrypt.
     The settings follow the editor's (AVP_OpenInteng.vcxproj): Release|Win32, v145, /MD, /sdl, Control Flow Guard, /J and /we4834; it is a
     console program, Unicode (it takes wide arguments), C++17. Its objects go to their own folder, so the two projects never share an .obj or
     a .pdb; the program goes beside the editor's in win32\VS2026\Win32\Release\.
     Like any ordinary tool it says what it is (Bishop's order 11-19, the owner's antivirus question): a version resource (tools\mp4-to-smk\mp4-to-smk.rc)
     and an application manifest naming Windows 10 and 11 (tools\mp4-to-smk\mp4-to-smk.manifest), with the linker's asInvoker.
     EncoderBuiltIn (true unless /p:EncoderBuiltIn=false) is that build: SMK_ENCODER_BUILT_IN, and dll_load.cpp left out. THE PROGRAM AS A WHOLE IS UNDER THE GNU
     LGPL 2.1, as it holds libsmackerenc (its version resource says so). /p:EncoderBuiltIn=false still builds the RETIRED DLL way (libsmackerenc.dll loaded at
     run time, pinned by its SHA-256): it is deleted, with dll_load and dll_pins, as a change of its own once the owner has ruled on the LGPL question. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1E96C66C-6BFA-4EB6-8D17-F72F0FF0786A}</ProjectGuid>
    <RootNamespace>mp4_to_smk</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <EncoderBuiltIn Condition="'$(EncoderBuiltIn)' == ''">true</EncoderBuiltIn>
    <!-- BCrypt hashes the encoder DLL for its pin (dll_load); with the encoder compiled in there is no DLL to hash -->
    <EncoderPinLibs Condition="'$(EncoderBuiltIn)' != 'true'">bcrypt.lib;</EncoderPinLibs>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <!-- THE ONE COMPILER, AvPx's (avpx\win32\msvc-pin.props says why): the same exact MSVC as the editor, the game and libsmackerenc.dll, and the
       build fails on any other. Before Microsoft.Cpp.props, which would otherwise take the newest installed MSVC. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\avpx\win32\msvc-pin.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <!-- Build output stays under win32\VS2026\Win32\, which .gitignore keeps out of the repository. -->
    <TargetName>mp4-to-smk</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\Win32\Release\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\Win32\Release\obj-mp4-to-smk\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <AdditionalIncludeDirectories>..\..\src\host;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- SMACKER_ENCODER_SHA256: the SHA-256 of the libsmackerenc.dll this build ships beside it (release.yml gives /p:SmackerEncoderSha256=<64 hex digits>; a
           local build gives its own DLL's), the only one the tool loads unless its option encoder-sha256 names another (the owner's ruling, 11-18). The define is the hex after an x
           (x alone: none pinned), so it is never empty: dll_pins.h takes the x off. -->
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;_CRT_SECURE_NO_DEPRECATE;_WIN32_WINNT=0x0602;_MSVC_STL_HARDENING=1;SMACKER_ENCODER_SHA256=x$(SmackerEncoderSha256);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <!-- THE SAME BYTES WHEREVER IT IS BUILT (Bishop 11-21, for alpha.5; as libsmackerenc.dll already is): /Brepro writes no time or random number into the
           objects; /pathmap (which needs /experimental:deterministic) names the tree's folder AVP_OpenInteng wherever it is checked out, so a build here and
           CI's give the same exe, and a VirusTotal scan here speaks for the release's (two builds from one folder differed before, and so did two folders) -->
      <AdditionalOptions> /J /we4834 /Brepro /experimental:deterministic /pathmap:$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\=\AVP_OpenInteng\</AdditionalOptions>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)vc.pdb</ProgramDataBaseFileName>
      <WarningLevel>Level3</WarningLevel>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <!-- Windows' own Media Foundation and its Audio Resampler (its class ID from wmcodecdspuuid), and BCrypt for the encoder's SHA-256 (dll_load), and nothing else -->
      <AdditionalDependencies>$(EncoderPinLibs)mfplat.lib;mfreadwrite.lib;mfuuid.lib;ole32.lib;wmcodecdspuuid.lib;wintrust.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <GenerateDebugInformation>DebugFull</GenerateDebugInformation>
      <SubSystem>Console</SubSystem>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <TargetMachine>MachineX86</TargetMachine>
      <!-- no more rights than the user's own: the manifest's trustInfo -->
      <UACExecutionLevel>AsInvoker</UACExecutionLevel>
      <!-- /Brepro: the exe's time stamp and its .pdb's GUID come from its contents, not the clock; /PDBALTPATH has it record only the .pdb's name, not the folder
           it was built in (as libsmackerenc.dll's link) -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% /Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32' and '$(EncoderBuiltIn)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>SMK_ENCODER_BUILT_IN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..\..\avpx\dependencies\libsmackerenc\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>SMK_ENCODER_BUILT_IN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\src\host\dll_load.cpp" Condition="'$(EncoderBuiltIn)' != 'true'" />
    <ClCompile Include="..\..\tools\mp4-to-smk\mp4-to-smk.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\src\host\dll_load.h" />
    <ClInclude Include="..\..\src\host\dll_pins.h" />
    <ClInclude Include="..\..\src\host\smk_encoder.h" />
    <ClInclude Include="..\..\src\host\video_import.h" />
    <ClInclude Include="..\..\src\host\video_make.h" />
  </ItemGroup>
  <!-- THE ONE LIBRARY (videomake_static.vcxproj says why), built first and linked in; IntDir not handed down, as for the encoder's below -->
  <ItemGroup>
    <ProjectReference Include="videomake_static.vcxproj">
      <Project>{2E2E00A0-1C79-46D1-96AC-2D2F8EFE2161}</Project>
      <GlobalPropertiesToRemove>IntDir</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <!-- EncoderBuiltIn=true: the encoder, a static library of its own (libsmackerenc_static.vcxproj says why), built first and linked in. IntDir is not handed
       down (a build given its own /p:IntDir would otherwise put the library's objects in with the program's): the library keeps its objects in a folder of
       their own under the OutDir it is given. -->
  <ItemGroup Condition="'$(EncoderBuiltIn)' == 'true'">
    <ProjectReference Include="libsmackerenc_static.vcxproj">
      <Project>{A227768E-A114-47D7-828D-EF334A517681}</Project>
      <GlobalPropertiesToRemove>IntDir</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="..\..\tools\mp4-to-smk\mp4-to-smk.rc" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="..\..\tools\mp4-to-smk\mp4-to-smk.manifest" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
