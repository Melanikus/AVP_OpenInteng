<?xml version="1.0" encoding="utf-8"?>
<!-- libsmackerenc_static: the Smacker film encoder made from Barry Duncan's libsmackerdec for Open Inteng (avpx\dependencies\libsmackerenc, GNU LGPL 2.1: its
     COPYING) built as a STATIC LIBRARY, which the editor links in (through videomake_static). Written 2026-11-21 by Melanikus (Drake) for AVP_OpenInteng, on the owner's order through
     Bishop: "GET MY DECODER OUT, WORKING", "STATIC LINK, SEPARATE BARRY'S LIBS, TEST IT".
     WHY A LIBRARY OF ITS OWN: the library's code stays apart from ours. Its sources are compiled here as they are in AvPx (not one line changed, not copied:
     the project reads them from the pinned avpx), with ITS OWN compiler settings, the Release block of its DLL's project
     (avpx\dependencies\libsmackerenc\win32\VS2026\smackerenc_dynamic.vcxproj), never the editor's: /Ox, /Ob2, /GF, /Gy, /arch:SSE, /sdl, Control Flow Guard,
     /MD, whole-program optimisation, NDEBUG and _MBCS, warning level 3, the compiler's own C++ standard. Only the output is different: a .lib, not a DLL, so no
     libsmackerenc.dll ships beside the editor, and none is loaded at run time.
     THE SAME BYTES WHEREVER IT IS BUILT, as its DLL: /Brepro writes no time or random number; /pathmap (which needs /experimental:deterministic) names the
     library's folder libsmackerenc wherever it is checked out, the same name its DLL's build gives it; the librarian's /Brepro the same for the .lib.
     The .lib is named libsmackerenc_static.lib so it can never be taken for the DLL's import library (libsmackerenc.lib).
     videomake_static's project takes it by a project reference, so building the editor builds this first. Its objects have their own folder under the output
     folder (IntDir below), so they never share an .obj or a .pdb with another project's. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A227768E-A114-47D7-828D-EF334A517681}</ProjectGuid>
    <RootNamespace>libsmackerenc_static</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- the library's own folder in the pinned avpx: its sources, its headers, and the root /pathmap names -->
    <SmackerEncRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\avpx\dependencies\libsmackerenc'))</SmackerEncRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <!-- THE ONE COMPILER, AvPx's (avpx\win32\msvc-pin.props says why): the same exact MSVC as the editor, the game and the libraries' DLLs, and the
       build fails on any other. Before Microsoft.Cpp.props, which would otherwise take the newest installed MSVC. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\avpx\win32\msvc-pin.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <!-- Build output stays under win32\VS2026\Win32\, which .gitignore keeps out of the repository; the .lib beside the programs, its objects in a folder
         of their own there -->
    <TargetName>libsmackerenc_static</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\Win32\Release\</OutDir>
    <IntDir>$(OutDir)obj-libsmackerenc\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Full</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <AdditionalIncludeDirectories>$(SmackerEncRoot)\include</AdditionalIncludeDirectories>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <StringPooling>true</StringPooling>
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions</EnableEnhancedInstructionSet>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <SDLCheck>true</SDLCheck>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)vc.pdb</ProgramDataBaseFileName>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/Brepro /experimental:deterministic /pathmap:$(SmackerEncRoot)\=\libsmackerenc\ %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Lib>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(SmackerEncRoot)\src\BitWriter.cpp" />
    <ClCompile Include="$(SmackerEncRoot)\src\HuffmanTree.cpp" />
    <ClCompile Include="$(SmackerEncRoot)\src\SmackerEncoder.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(SmackerEncRoot)\include\BitWriter.h" />
    <ClInclude Include="$(SmackerEncRoot)\include\HuffmanTree.h" />
    <ClInclude Include="$(SmackerEncRoot)\include\SmackerEncoder.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
