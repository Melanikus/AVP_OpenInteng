<?xml version="1.0" encoding="utf-8"?>
<!-- videomake_static: THE ONE LIBRARY that makes a user's video into an AvP message film, which BOTH mp4-to-smk.exe and the editor's Video mode link (the owner's
     Video mode, 11-22; Bishop 2's brief: "sharing mp4-to-smk.cpp's reader and encoder in one library both link (never a fork)"). Written 2026-11-22 by Melanikus
     (Dietrich) for AVP_OpenInteng; its sources are AVP_OpenInteng's own code (MIT, License.txt):
       src\host\video_import   the video read through Windows' own Media Foundation, its hostile-file checks and the one list of endings
       src\host\video_make     the cut, the level and volume, the save that keeps a replaced film first
       src\host\smk_encoder    the clip handed to libsmackerenc (LGPL 2.1, its own static library, libsmackerenc_static.vcxproj) and the film written out
     It is built with mp4-to-smk's own compiler settings (Release|Win32, v145, Unicode, /MD, /sdl, Control Flow Guard, /J and /we4834, C++17, the STL's hardening,
     whole-program optimisation), so a program that links it gets the very code mp4-to-smk was tested with. EncoderBuiltIn (true unless /p:EncoderBuiltIn=false)
     as mp4-to-smk's: SMK_ENCODER_BUILT_IN, the encoder's three calls taken from the library linked in.
     THE SAME BYTES WHEREVER IT IS BUILT: /Brepro and /pathmap as mp4-to-smk's, the librarian's /Brepro the same for the .lib. Its objects have their own folder
     under the output folder (IntDir below), so they never share an .obj or a .pdb with another project's. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{2E2E00A0-1C79-46D1-96AC-2D2F8EFE2161}</ProjectGuid>
    <RootNamespace>videomake_static</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <EncoderBuiltIn Condition="'$(EncoderBuiltIn)' == ''">true</EncoderBuiltIn>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <!-- THE ONE COMPILER, AvPx's (avpx\win32\msvc-pin.props says why): the same exact MSVC as the editor, the game and the libraries, and the build fails on any
       other. Before Microsoft.Cpp.props, which would otherwise take the newest installed MSVC. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\avpx\win32\msvc-pin.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <!-- Build output stays under win32\VS2026\Win32\, which .gitignore keeps out of the repository; the .lib beside the programs, its objects in a folder of their
         own there -->
    <TargetName>videomake_static</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\Win32\Release\</OutDir>
    <IntDir>$(OutDir)obj-videomake\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <AdditionalIncludeDirectories>..\..\src\host;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;_CRT_SECURE_NO_DEPRECATE;_WIN32_WINNT=0x0602;_MSVC_STL_HARDENING=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions> /J /we4834 /Brepro /experimental:deterministic /pathmap:$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\=\AVP_OpenInteng\</AdditionalOptions>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)vc.pdb</ProgramDataBaseFileName>
      <WarningLevel>Level3</WarningLevel>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Lib>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <LinkTimeCodeGeneration>true</LinkTimeCodeGeneration>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32' and '$(EncoderBuiltIn)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>SMK_ENCODER_BUILT_IN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..\..\avpx\dependencies\libsmackerenc\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\src\host\media_parsers.cpp" />
    <ClCompile Include="..\..\src\host\smk_encoder.cpp" />
    <ClCompile Include="..\..\src\host\video_import.cpp" />
    <ClCompile Include="..\..\src\host\video_make.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\src\host\media_parsers.h" />
    <ClInclude Include="..\..\src\host\smk_encoder.h" />
    <ClInclude Include="..\..\src\host\video_import.h" />
    <ClInclude Include="..\..\src\host\video_make.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
