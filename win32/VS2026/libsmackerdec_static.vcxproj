<?xml version="1.0" encoding="utf-8"?>
<!-- libsmackerdec_static: Barry Duncan's Smacker film decoder (avpx\dependencies\libsmackerdec, GNU LGPL 2.1: its COPYING) built as a STATIC LIBRARY, which
     the editor links in for its FMV preview (and the game's own film player, which the editor compiles, calls). Written 2026-11-21 by Melanikus (Drake) for
     AVP_OpenInteng, on the owner's order through Bishop: "GET MY DECODER OUT, WORKING", "STATIC LINK, SEPARATE BARRY'S LIBS, TEST IT".
     WHY A LIBRARY OF ITS OWN: Barry's code stays apart from ours. Its sources are compiled here as they are in AvPx (not one line changed, not copied: the
     project reads them from the pinned avpx), with ITS OWN compiler settings, the Release block of its DLL's project
     (avpx\dependencies\libsmackerdec\win32\VS2026\smackerdec_dynamic.vcxproj), never the editor's: /Ox, /Ob2, /GF, /Gy, /arch:SSE, /sdl, Control Flow Guard,
     /MD, whole-program optimisation, NDEBUG and _MBCS, warning level 3, the compiler's own C++ standard. Only the output is different: a .lib, not a DLL, so no
     libsmackerdec.dll ships beside the editor, and none is loaded at run time.
     THE SAME BYTES WHEREVER IT IS BUILT, as its DLL: /Brepro writes no time or random number; /pathmap (which needs /experimental:deterministic) names the
     library's folder libsmackerdec wherever it is checked out, the same name its DLL's build gives it; the librarian's /Brepro the same for the .lib.
     The .lib is named libsmackerdec_static.lib so it can never be taken for the DLL's import library (libsmackerdec.lib).
     The editor's project takes it by a project reference, so building the editor builds this first. Its objects have their own folder under the editor's
     output folder (IntDir below), so they never share an .obj or a .pdb with the editor's own (the game has a FileStream.cpp too). -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{2A1A22CC-E905-4383-89A6-62D664208D3B}</ProjectGuid>
    <RootNamespace>libsmackerdec_static</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- the library's own folder in the pinned avpx: its sources, its headers, and the root /pathmap names -->
    <SmackerDecRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\avpx\dependencies\libsmackerdec'))</SmackerDecRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <!-- THE ONE COMPILER, AvPx's (avpx\win32\msvc-pin.props says why): the same exact MSVC as the editor, the game and the libraries' DLLs, and the
       build fails on any other. Before Microsoft.Cpp.props, which would otherwise take the newest installed MSVC. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\avpx\win32\msvc-pin.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <!-- Build output stays under win32\VS2026\Win32\, which .gitignore keeps out of the repository; the .lib beside the editor's program, its objects in a
         folder of their own there -->
    <TargetName>libsmackerdec_static</TargetName>
    <OutDir>$(MSBuildProjectDirectory)\Win32\Release\</OutDir>
    <IntDir>$(OutDir)obj-libsmackerdec\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Full</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <AdditionalIncludeDirectories>$(SmackerDecRoot)\include</AdditionalIncludeDirectories>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <StringPooling>true</StringPooling>
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions</EnableEnhancedInstructionSet>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <SDLCheck>true</SDLCheck>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)vc.pdb</ProgramDataBaseFileName>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/Brepro /experimental:deterministic /pathmap:$(SmackerDecRoot)\=\libsmackerdec\ %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Lib>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(SmackerDecRoot)\src\BitReader.cpp" />
    <ClCompile Include="$(SmackerDecRoot)\src\FileStream.cpp" />
    <ClCompile Include="$(SmackerDecRoot)\src\HuffmanVLC.cpp" />
    <ClCompile Include="$(SmackerDecRoot)\src\LogError.cpp" />
    <ClCompile Include="$(SmackerDecRoot)\src\SmackerDecoder.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(SmackerDecRoot)\include\BitReader.h" />
    <ClInclude Include="$(SmackerDecRoot)\include\FileStream.h" />
    <ClInclude Include="$(SmackerDecRoot)\include\HuffmanVLC.h" />
    <ClInclude Include="$(SmackerDecRoot)\include\LogError.h" />
    <ClInclude Include="$(SmackerDecRoot)\include\SmackerDecoder.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
