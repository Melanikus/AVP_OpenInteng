					"to": "\t\treturn std::string(text, 0, kPaintMostLetters);"
				}
			]
		},
		{
			"name": "a panel's text isn't cut to its box",
			"changes": [
				{
					"file": "src/host/panel_paint.cpp",
					"from": "\t\tOnlineScreens_FitToWidth(letters, (int)room, widthOf);\n",
					"to": ""
				}
			]
		},
		{
			"name": "a box with no room across shows text",
			"changes": [
				{
					"file": "src/host/panel_paint.cpp",
					"from": "if (room <= 0 || height < line ||",
					"to": "if (height < line ||"
				}
			]
		},
		{
			"name": "a box not one line tall shows text",
			"changes": [
				{
					"file": "src/host/panel_paint.cpp",
