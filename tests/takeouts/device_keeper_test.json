					"from": "\t\t\t\tLetGoOfEverything();\n\t\t\t\tTryAgainAfter(nowMs, kLostAskAgainMs);",
					"to": "\t\t\t\tTryAgainAfter(nowMs, kLostAskAgainMs);"
				}
			]
		},
		{
			"name": "a lost device is asked again at once",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "TryAgainAfter(nowMs, kLostAskAgainMs);",
					"to": "TryAgainAfter(nowMs, 0);"
				}
			]
		},
		{
			"name": "a broken device is drawn again later",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
