					"file": "src/host/device_keeper.cpp",
					"from": "\t\tif (!seam.MakePanels(wantedPanelsWidth, wantedPanelsHeight))\n\t\t{\n\t\t\tFailed(nowMs);\n\t\t\treturn false;\n\t\t}",
