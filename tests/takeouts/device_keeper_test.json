					"from": "\t\tif (!seam.RemakeResources())\n\t\t{\n\t\t\tFailed(nowMs);\n\t\t\treturn false;\n\t\t}\n\n\t\thasResources = true;\n\n\t\t// The panels last",
					"to": "\t\tseam.RemakeResources();\n\t\thasResources = true;\n\n\t\t// The panels last"
				}
			]
		},
		{
			"name": "a reset makes no panels after it",
			"changes": [
