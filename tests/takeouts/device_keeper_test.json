					"from": "\t\tif (!MakePanels(wantedPanelsWidth, wantedPanelsHeight, nowMs))\n\t\t{\n\t\t\treturn false;\n\t\t}\n\n\t\treturn Drawn();",
					"to": "\t\treturn Drawn();"
				}
			]
		},
