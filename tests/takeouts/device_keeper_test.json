					"file": "src/host/device_keeper.cpp",
					"from": "\t\tif (hasPanels)\n\t\t{\n\t\t\tseam.LetGoOfPanels();\n\t\t\thasPanels = false;\n\t\t}\n\n\t\tif (!seam.MakePanels",
					"to": "\t\tif (!seam.MakePanels"
				}
			]
		},
		{
			"name": "a new window for the panels keeps the old ones",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "void DeviceKeeper::PanelsWindowChanged()\n\t{\n\t\tif (hasPanels)",
					"to": "void DeviceKeeper::PanelsWindowChanged()\n\t{\n\t\tif (false)"
				}
			]
		},
