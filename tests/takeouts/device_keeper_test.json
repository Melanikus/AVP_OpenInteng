		"tests"
	],
	"rows": [
		{
			"name": "a side below 0 is kept below 0",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "return side < 0 ? 0 : side > kSurfaceMostSide ? kSurfaceMostSide : side;",
					"to": "return side > kSurfaceMostSide ? kSurfaceMostSide : side;"
				}
			]
		},
		{
			"name": "a side above the most is kept",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "return side < 0 ? 0 : side > kSurfaceMostSide ? kSurfaceMostSide : side;",
					"to": "return side < 0 ? 0 : side;"
				}
			]
		},
		{
			"name": "a minimised parent is asked and reset",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "if (Side(windowWidth) == 0 && Side(windowHeight) == 0)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "minimised is told from the view's size, not the parent's",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "if (Side(windowWidth) == 0 && Side(windowHeight) == 0)",
					"to": "if (Side(viewWidth) == 0 && Side(viewHeight) == 0)"
				}
			]
		},
		{
			"name": "a side of 0 is drawn as 0",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "return kept < 1 ? 1 : kept;",
					"to": "return kept;"
				}
			]
		},
		{
			"name": "a waiting device is asked before its time",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "if (waiting && !TimeHasCome(nowMs, tryAt))",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "the clock's wrap is read as a plain number",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "return (int32_t)(nowMs - atMs) >= 0;",
					"to": "return nowMs >= atMs;"
				}
			]
		},
		{
			"name": "a fine device at a new view size isn't reset",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "if (wantedWidth != width || wantedHeight != height)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "a device back by itself draws without its resources",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
					"from": "\t\t\t\tif (!hasResources)\n\t\t\t\t{\n\t\t\t\t\tif (!seam.RemakeResources())",
					"to": "\t\t\t\tif (false)\n\t\t\t\t{\n\t\t\t\t\tif (!seam.RemakeResources())"
				}
			]
		},
		{
			"name": "a new size for the parent alone doesn't make the panels again",
			"changes": [
				{
					"file": "src/host/device_keeper.cpp",
