	"rows": [
		{
			"name": "the chunk's heading is counted as 8 bytes, not 12",
			"changes": [
				{
					"file": "src/host/strategy_lookup.cpp",
					"from": "size_t const ChunkHeadingBytes = 12;",
					"to": "size_t const ChunkHeadingBytes = 8;"
				}
			]
		},
		{
			"name": "the least a strategy can be is 21 bytes, not 20",
			"changes": [
				{
					"file": "src/host/strategy_lookup.cpp",
					"from": "size_t const LeastPayloadBytes = 20;",
					"to": "size_t const LeastPayloadBytes = 21;"
				}
			]
		},
		{
			"name": "a strategy of exactly the least size is refused",
			"changes": [
				{
					"file": "src/host/strategy_lookup.cpp",
					"from": "if (whole < ChunkHeadingBytes + LeastPayloadBytes)",
					"to": "if (whole <= ChunkHeadingBytes + LeastPayloadBytes)"
				}
			]
		},
		{
			"name": "a strategy chunk holding no strategy is asked for its size",
			"changes": [
				{
