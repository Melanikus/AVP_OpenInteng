					"from": "if (whole - ChunkHeadingBytes > kStrategyLookupMostBytes)",
					"to": "if (whole - ChunkHeadingBytes >= kStrategyLookupMostBytes)"
				}
			]
		},
		{
			"name": "a payload over the most is given",
			"changes": [
				{
					"file": "src/host/strategy_lookup.cpp",
					"from": "if (whole - ChunkHeadingBytes > kStrategyLookupMostBytes)",
					"to": "if (false)"
				}
			]
		},
