				}
			]
		},
		{
			"name": "a fraction is taken as an axis value",
			"changes": [
				{
					"file": "src/host/record_edit.cpp",
					"from": "&& value == (double)(int32_t)value;",
					"to": ";"
				}
			]
		},
		{
			"name": "a choice needn't be named",
			"changes": [
				{
					"file": "src/host/record_edit.cpp",
