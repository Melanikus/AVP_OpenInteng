{
	"copy": [
		"avpx/tests/every_test",
		"avpx/3dc",
		"src",
		"tests"
	],
	"rows": [
		{
			"name": "Open level does nothing",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\thost->statusWords = kEditorOpenNotYetWords;",
					"to": "\t;"
				}
			]
		},
		{
			"name": "Quit leaves the editor running",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\thost->running = false;",
					"to": "\t;"
				}
			]
		},
		{
			"name": "Help, Keys says Classic's keys in any layout",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\thost->statusWords = EditorActions_KeysWords(host->layout);",
					"to": "\thost->statusWords = EditorActions_KeysWords(KeyLayout::Classic);"
				}
			]
		},
		{
			"name": "the Classic item picks Modern",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\thost->layout = KeyLayout::Classic;",
					"to": "\thost->layout = KeyLayout::ModernWasd;"
				}
			]
		},
		{
			"name": "the Modern item changes nothing",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\thost->layout = KeyLayout::ModernWasd;",
					"to": "\t;"
				}
			]
		},
		{
			"name": "Ctrl+O is no key in Classic",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "{ 'O', true }, { 'O', true }, 0,        OpenLevel }",
					"to": "{ 0 },         { 'O', true }, 0,        OpenLevel }"
				}
			]
		},
		{
			"name": "Polyline has no key",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "{ '8' },       { '8' },       0,        ViewPolyline }",
					"to": "{ 0 },         { 0 },         0,        ViewPolyline }"
				}
			]
		},
		{
			"name": "Classic's forward is W",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "{ EditorMove::Forward,   \"forward\",    'A',         'W' },",
					"to": "{ EditorMove::Forward,   \"forward\",    'W',         'W' },"
				}
			]
		},
		{
			"name": "the keypad's minus goes down",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "{ EditorMove::Up,        \"up\",         VK_SUBTRACT, 'R' },",
					"to": "{ EditorMove::Up,        \"up\",         VK_ADD,      'R' },"
				}
			]
		},
		{
			"name": "the keypad's numbers are named one too high",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\"Num %d\", key - VK_NUMPAD0",
					"to": "\"Num %d\", key - VK_NUMPAD0 + 1"
				}
			]
		},
		{
			"name": "plus and minus are named the wrong way round",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "key == VK_ADD ? '+' : '-'",
					"to": "key == VK_ADD ? '-' : '+'"
				}
			]
		},
		{
			"name": "Ctrl is left out of the words",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "key.ctrl ? \"Ctrl+\" : \"\"",
					"to": "\"\""
				}
			]
		},
		{
			"name": "Shift is left out of the words",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "key.shift ? \"Shift+\" : \"\"",
					"to": "\"\""
				}
			]
		},
		{
			"name": "words too long for their room are kept",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
