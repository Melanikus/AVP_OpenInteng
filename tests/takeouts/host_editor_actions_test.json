			"name": "no room is written to",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\tif (!words || size == 0)\n\t{\n\t\treturn false;\n\t}\n\n\twords[0] = '\\0';",
					"to": "\tif (!words)\n\t{\n\t\treturn false;\n\t}\n\n\twords[0] = '\\0';"
				}
			]
		},
		{
			"name": "an action's key is always the Classic one",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "return layout == KeyLayout::ModernWasd ? action.modern : action.classic;",
					"to": "return action.classic;"
				}
			]
		},
		{
			"name": "two actions may share a key",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "if (other.virtualKey == key.virtualKey && other.ctrl == key.ctrl && other.shift == key.shift)",
					"to": "if (false)"
				}
			]
		},
		{
			"name": "Ctrl and Shift don't make another key",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "if (other.virtualKey == key.virtualKey && other.ctrl == key.ctrl && other.shift == key.shift)",
					"to": "if (other.virtualKey == key.virtualKey)"
				}
			]
		},
		{
			"name": "an action may take a key the camera holds",
			"changes": [
