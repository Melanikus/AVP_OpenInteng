				}
			]
		},
		{
			"name": "an action may do nothing",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "if (!action.name || !action.name[0] || !action.run)",
					"to": "if (!action.name || !action.name[0])"
				}
			]
		},
