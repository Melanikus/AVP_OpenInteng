				}
			]
		},
		{
			"name": "an action's key needs no name",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "\t\t\tif (!EditorActions_KeyWords(key, words, sizeof(words)))\n",
					"to": "\t\t\tif (false)\n"
				}
			]
		},
		{
			"name": "a number of 0 passes",
			"changes": [
				{
					"file": "src/host/editor_actions.cpp",
					"from": "if (action.id <= 0)",
