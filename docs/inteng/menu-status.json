	"additions": [
		{ "table": "0x5ced30", "title": "File", "after": "Quit", "words": "&Save", "action": "0x1ff01", "does": "savecopy", "note": "THE OWNER'S ADDITION (Melanikus 2026-11-16, through Bishop: \"Let's put a save on the hub\"): inteng's hub File has no Save. It sits second, after Quit, where every other screen keeps its Save, and does what Object Placement's Save does (SaveCopy). Its number is ours; it has no inteng command" },
		{ "table": "0x5ced30", "title": "Options", "after": "Use Polygon View Distance", "words": "Text size 1", "action": "0x1ff02", "does": "textscale", "note": "THE OWNER'S ADDITION (Melanikus 2026-11-16, 16 px too small at 2560 x 1440; Bishop 11-18): the text scale's first step, 1, inteng's own size (text_scale.h). Ticked while it is the scale; kept as FontScale= in AVP_OpenInteng.ini. Its number is ours; it has no inteng command" },
		{ "table": "0x5ced30", "title": "Options", "after": "Text size 1", "words": "Text size 1.25", "action": "0x1ff03", "does": "textscale", "note": "THE OWNER'S ADDITION: the text scale's step 1.25 (text_scale.h): every letter, bar, row and dialog a quarter bigger, at once. Its number is ours; it has no inteng command" },
		{ "table": "0x5ced30", "title": "Options", "after": "Text size 1.25", "words": "Text size 1.5", "action": "0x1ff04", "does": "textscale", "note": "THE OWNER'S ADDITION: the text scale's step 1.5 (text_scale.h). Its number is ours; it has no inteng command" },
		{ "table": "0x5ced30", "title": "Options", "after": "Text size 1.5", "words": "Text size 2", "action": "0x1ff05", "does": "textscale", "note": "THE OWNER'S ADDITION: the text scale's step 2 (text_scale.h); FontScale= takes up to 3 by hand. Its number is ours; it has no inteng command" },
		{ "table": "0x5ced30", "title": "Mode", "after": "Hierarchy", "words": "&Video", "action": "0x1ff06", "does": "videomode", "note": "THE OWNER'S ADDITION (Melanikus 2026-11-22, alpha.5 item 2, through Bishop 2: \"let's add a new mode for video, it only has load and mode exit\"; \"Don't put it directly on strategy mode\"): the Video screen (video_mode_screen.h), a mode of its own after Hierarchy. Its number is ours; it has no inteng command" }
	],
